# Contact form delivery (app/api/sendEmail/route.ts) via AWS SES.
#
# On Vercel use the SES_* names. Vercel injects its own AWS_REGION,
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY into every function and those
# values carry no AWS permissions, so the SES_* names are read first.
# The AWS_* names still work as a fallback for local development.

# Region where the FROM_EMAIL identity is verified in SES, e.g. us-west-2
SES_REGION=
# IAM access key with ses:SendEmail permission
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Verified SES sender address
FROM_EMAIL=
# Where contact form submissions are delivered (must also be verified while
# the SES account is in the sandbox)
TO_EMAIL=
CC_EMAIL=
EMAIL_SUBJECT=New message from betweentheheights.com
