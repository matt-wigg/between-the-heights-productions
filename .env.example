# Contact form delivery (app/api/sendEmail/route.ts) via Resend.
# Copy to .env.local for local development. On Vercel, add these under
# Settings -> Environment Variables and redeploy.

# Required ------------------------------------------------------------------

# API key from https://resend.com/api-keys (starts with "re_")
RESEND_API_KEY=

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=danielduvall22@gmail.com

# Optional ------------------------------------------------------------------

# Sender shown on the email. Leave unset to use Resend's shared
# onboarding@resend.dev address (no domain setup, but it can only deliver to
# the email address that owns the Resend account). Set to an address on a
# domain verified in Resend to deliver anywhere, e.g.
# RESEND_FROM_EMAIL="Between The Heights <hello@betweentheheights.com>"
RESEND_FROM_EMAIL=

# Extra recipient copied on every submission
CONTACT_CC_EMAIL=

# Subject prefix; the sender's name is appended
CONTACT_SUBJECT=New website message
